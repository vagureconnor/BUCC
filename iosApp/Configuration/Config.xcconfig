TEAM_ID=

PRODUCT_NAME=BUCC
PRODUCT_BUNDLE_IDENTIFIER=app.bucc

CURRENT_PROJECT_VERSION=40
MARKETING_VERSION=2.0.0

// Xcode 通过 Gradle 构建的 Kotlin framework 位于此目录。
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../composeApp/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
OTHER_LDFLAGS = $(inherited) -framework ComposeApp -framework Security -framework CFNetwork -framework SystemConfiguration -framework Network
